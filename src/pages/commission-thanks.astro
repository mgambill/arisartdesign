---
import { Image } from "astro:assets"
import Layout from "../layouts/Layout.astro"
import MeJoy from '../assets/images/me_joyful.png';
import Banner from "src/components/Banner.astro"

---

<Layout title="Commission Request">
  <Banner label="Commission Request"/>
  <!-- Main content -->
  <div class="flex-1 xl:overflow-y-auto">
    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">

      <p class="pt-8 text-center text-lg">Thanks your request has been submitted! I will be in touch with you soon to discuss the details of your commission.</p>

      <Image src={MeJoy} alt="Happy Ari picture" width={500} class="mx-auto"/>

      <canvas id="confetti-canvas" style="position:fixed;pointer-events:none;top:0;left:0;width:100vw;height:100vh;z-index:9999" ></canvas>
    </div>
  </div>
</Layout>

<script>
  import confetti from "canvas-confetti"

  document.addEventListener("DOMContentLoaded", () => {
    // Fire confetti when the page loads
    confetti.create(document.getElementById("confetti-canvas"), { resize: true })({

      colors: ['FFE400', 'FFBD00', 'E89400', 'FFCA6C', 'FDFFB8'],
      particleCount: 150,
      spread: 180,
      origin: { y: 0.50 },
      shapes: ['star']
    })
  })
</script>
