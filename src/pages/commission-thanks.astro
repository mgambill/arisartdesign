---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Commission Request">
  <!-- Main content -->
  <div class="flex-1 xl:overflow-y-auto">
    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 text-center">Artwork Commission Request</h1>

      <p class="pt-8 text-center">Thanks your request has been submitted! I will be in touch with you soon to discuss the details of your commission.</p>

      <img src="src/assets/images/me_joyful.jpg"/>

      <canvas id="confetti-canvas" style="position:fixed;pointer-events:none;top:0;left:0;width:100vw;height:100vh;z-index:9999" ></canvas>
    </div>
  </div>
</Layout>

<script>
  import confetti from "canvas-confetti"

  document.addEventListener("DOMContentLoaded", () => {
    // Fire confetti when the page loads
    confetti.create(document.getElementById("confetti-canvas"), { resize: true })({

      colors: ['FFE400', 'FFBD00', 'E89400', 'FFCA6C', 'FDFFB8'],
      particleCount: 150,
      spread: 180,
      origin: { y: 0.25 },
      shapes: ['star']
    })
  })
</script>
