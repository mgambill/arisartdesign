---
import { getEntry, getCollection, render } from "astro:content"
import Layout from "../layouts/Layout.astro"
import Hero from "src/components/Hero.astro"
import PortfolioGallery from "src/components/PortfolioGallery"
import { getImage } from "astro:assets"

const homePage = await getEntry("pages", "home")
const portfolio = await getCollection("portfolio")

const portfolioItems = await Promise.all(
  portfolio.filter(a => a.data.showOnHome).map(async (item) => {
    const optimizedImage = await getImage({ src: item.data.image })
    return {
      id: item.id,
      title: item.data.title,
      image: optimizedImage.src,
      category: item.data.category
    }
  })
)

// .filter(a => [].contains(a.id) )
---

<Layout title="">
  <div class="w-full">
    <Hero />

    <div class="p-10">
      <PortfolioGallery client:load items={portfolioItems} />

    </div>

  </div>
</Layout>
