<Layout title="">
  <div class="w-full">
    <Hero />

    <div class="p-6">
      <div class="columns-1 sm:columns-2 lg:columns-3">
        {portfolio.filter(a => a.data.showOnHome).map((a) => <BlockImage data-category={a.data.category} slug={a.id} url={`/gallery/${a.id}`} title={a.data.title} image={a.data.image} />)}
      </div>

