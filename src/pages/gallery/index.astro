      <div class="columns-1 sm:columns-2 lg:columns-3">
        {portfolio.map((a) => <BlockImage data-category={a.data.category} url={`/gallery/${a.id}`} slug={a.id} title={a.data.title} image={a.data.image} />)}
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  function filterPortfolio() {
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter');
    document.querySelectorAll('.portfolio-item').forEach(el => {
      if (!filter || filter.toLowerCase() === 'all' || el.getAttribute('data-category') === filter) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });
  }
  window.addEventListener('DOMContentLoaded', filterPortfolio);
  window.addEventListener('popstate', filterPortfolio);
</script>