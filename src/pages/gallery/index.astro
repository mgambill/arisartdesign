---
import Banner from "src/components/Banner.astro"
import BlockImage from "src/components/BlockImage.astro"
import PortfolioGallery from "src/components/PortfolioGallery"
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { getImage } from "astro:assets"

const filter = Astro.url.searchParams.get("filter") || ""
const portfolio = await getCollection("portfolio")
const categories = await getCollection("categories")

// Prepare portfolio items for the React component
const portfolioItems = await Promise.all(
  portfolio.map(async (item) => {
    const optimizedImage = await getImage({ src: item.data.image })
    return {
      id: item.id,
      title: item.data.title,
      image: optimizedImage.src,
      category: item.data.category
    }
  })
)

