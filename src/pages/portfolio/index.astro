---
import Banner from "src/components/Banner.astro"
import BlockImage from "src/components/BlockImage"
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { Image } from "astro:assets"

const links = [{ label: "Portfolio" }]
const filter = Astro.url.searchParams.get("filter") || ""
const portfolio = await getCollection("portfolio")
const categories = await getCollection("categories")

// Custom groupBy function
function groupBy(array, keyFn) {
  return array.reduce((result, item) => {
    const key = keyFn(item)
    if (!result[key]) {
      result[key] = []
    }
    result[key].push(item)
    return result
  }, {})
}

const groupedItems = groupBy(portfolio, (x) => x.data.category)

// Filter groupedItems based on the filter variable
const filteredItems = filter && filter.toLowerCase() !== "all" ? groupedItems[filter] : portfolio

const resolveCategory = (cat: string) => categories.find((c) => c.id === cat)
const allCategory = { id: "", data: { label: "All" }, count: portfolio.length }
---

<Layout title="Portfolio">
  <div class="flex flex-col">
    <Banner label="Portfolio" />
    <div class="p-10">
      <div class="pb-10">
        {
          [allCategory, ...categories].map((cat, i) => (
            <>
              <> {i > 0 && <span class="mx-1">|</span>}</>
              <a
                href={`/portfolio/?filter=${cat.id}`}
                class:list={["mx-1 rounded px-4 py-1.5 ", filter === cat.id ? "bg-primary text-white" : "hover:bg-blue-100 hover:text-blue-700 "]}
              >
                {cat.data?.label}({cat.count ?? groupedItems[cat.id]?.length ?? 0})
              </a>
            </>
          ))
        }
      </div>

      <div class="columns-1 sm:columns-2 lg:columns-3">
        {filteredItems && filteredItems.map((a) => <BlockImage url={`/portfolio/${a.id}`} title={a.data.title} image={a.data.image} />)}
      </div>
    </div>
  </div>
</Layout>
