---

import { getCollection } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import PortfolioGallery from "src/components/PortfolioGallery"
import Banner from "src/components/Banner.astro"
import { getImage } from "astro:assets"

const { category } = Astro.params
if (!category) throw new Error('Category not found')


const categories = await getCollection("categories")
const portfolio = await getCollection("portfolio", (a) => a.data.categories?.includes(category));
const currentCategory = categories.find((c) => c.id === category);

// Prepare portfolio items for the React component
const portfolioItems = await Promise.all(
  portfolio.map(async (item) => {
    const optimizedImage = await getImage({ src: item.data.image })
    return {
      id: item.id,
      title: item.data.title,
      image: optimizedImage.src,
      category: item.data.category
    }
  })
)

const map = {
  "visual-development": "Visual Development",
  "character-design": "Character Design",
}
// .filter(a => [].contains(a.id) )
---

<Layout title="">
  <div class="w-full">

    <Banner label={currentCategory?.data.label ?? ''} />

    <div class="p-10">
      <PortfolioGallery client:load items={portfolioItems} />
    </div>
  </div>
</Layout>
