---
import Banner from "/src/components/Banner.astro"
import BlockImage from "/src/components/BlockImage.astro"
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { Image } from "astro:assets"

const projects = await getCollection("projects")

---

<Layout title="Miscellaneous">
  <div class="flex flex-col">
    <Banner label="Miscellaneous" />
    <div class="p-10">
      <div class="columns-1 sm:columns-2 lg:columns-3">
        {projects.map((a) => <BlockImage url={`/misc/${a.id}`} title={a.data.title} image={a.data.image} />)}
      </div>
    </div>
  </div>
</Layout>
