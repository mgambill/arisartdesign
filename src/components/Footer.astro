---
import SocialLinks from './SocialLinks'
---
    <footer class="relative bg-white/30 dark:bg-transparent ">
      <div
        class="  mx-auto border-t border-stone-50 bg-white shadow-sm dark:border-stone-900 dark:bg-black"
      >
        <div class="bg-white sm:px-20 border-t border-gray-900/10">

          <div
            class=" pt-8 md:flex md:items-center md:justify-between pb-10"
          >
            <SocialLinks className="flex gap-x-6 md:order-2" />
            <p class="mt-8 text-gray-600 md:order-1 md:mt-0">
              &copy; {new Date().getFullYear()} Ari's Art Designs, Inc. All rights
              reserved.
            </p>
          </div>
        </div>
      </div>
    </footer>
